{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Circuit",
  "version": "1.0.0",
  "identifier": "com.blacklabel.circuit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Circuit",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "__PUBLISHER_DISPLAY_NAME__",
    "category": "DeveloperTool",
    "shortDescription": "Grade your codebase like a senior engineer, see the wiring in 3D.",
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "app"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "7",
      "minimumSystemVersion": "13.0"
    }
  }
}
