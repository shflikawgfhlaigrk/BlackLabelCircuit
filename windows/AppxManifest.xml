<?xml version="1.0" encoding="utf-8"?>
<!--
  Black Label Circuit - MSIX AppxManifest TEMPLATE (STAGED; not submittable as-is).

  The __WINDOWS_MSIX_*__ identity placeholders are substituted by windows/package-msix.ps1 from
  WINDOWS_MSIX_* environment values (the exact strings Partner Center assigns). Absent those values
  the script stamps the inert __PARTNER_CENTER_PENDING__ sentinel instead, so the manifest is
  deliberately NOT submittable: the publisher identity is a founder-only value and is never
  invented. See windows/README.md for the full gate law.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="__WINDOWS_MSIX_IDENTITY_NAME__"
    Publisher="__WINDOWS_MSIX_PUBLISHER__"
    Version="__WINDOWS_MSIX_VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Black Label Circuit</DisplayName>
    <PublisherDisplayName>__WINDOWS_MSIX_PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- The pkg-built Node exe (single-file server + browser UI) runs as a full-trust Win32 app. -->
    <Application Id="BlackLabelCircuit" Executable="BlackLabelCircuit.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Black Label Circuit"
        Description="Circuit — grade your codebase like a senior engineer, see the wiring in 3D"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
