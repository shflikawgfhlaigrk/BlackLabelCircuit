<Window x:Class="BlackLabel.Ace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ace" Width="1180" Height="760" Background="#080A0F" Foreground="#F4F5F7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="#4A4025" BorderThickness="0,0,1,0" Padding="16"><StackPanel><TextBlock Text="ACE" Foreground="#F4CF69" FontSize="27" FontWeight="Bold"/><TextBlock Text="BUILD 87 · PRIVATE ASSISTANT" Foreground="#A58F50" Margin="0,2,0,18"/><Button Content="Gold · Conversation" Click="Lane" Margin="0,3" Padding="10"/><Button Content="Red · Reviewed Tasks" Click="Lane" Margin="0,3" Padding="10"/><Button Content="Blue · Meeting Notes" Click="Lane" Margin="0,3" Padding="10"/><Button Content="Purple · Chart Analysis" Click="Lane" Margin="0,3" Padding="10"/><Button Content="Silver · Background" Click="Lane" Margin="0,3" Padding="10"/><Separator Margin="0,18"/><Button x:Name="PrivateButton" Content="Enter Private Mode" Click="TogglePrivate" Padding="10"/></StackPanel></Border><Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" Text="Conversation" FontSize="30" Foreground="#F4CF69"/><StackPanel Grid.Row="1" Margin="0,22,0,0"><TextBlock x:Name="EmptyText" Text="No conversation or customer data is bundled. Connect your own ChatGPT or Claude provider." TextWrapping="Wrap" FontSize="16"/><TextBox x:Name="Input" Height="120" Margin="0,18,0,8" Padding="12" AcceptsReturn="True" TextWrapping="Wrap" Background="#11151E" Foreground="White" BorderBrush="#4A4025"/><WrapPanel><Button Content="Save local draft" Click="SaveDraft" Padding="16,9" Margin="0,0,8,0"/><Button Content="Create review receipt" Click="Review" Padding="16,9" Margin="0,0,8,0"/><Button Content="Save meeting notes" Click="Meeting" Padding="16,9"/></WrapPanel><TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="#F4CF69"/></StackPanel><TextBlock Grid.Row="2" Text="LOCAL VOICE · EXACT REVIEW · INSPECTABLE RECEIPTS · NO ANALYTICS" Foreground="#A58F50"/></Grid></Grid></Window>
